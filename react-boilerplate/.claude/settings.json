{
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:code.claude.com)",
      "Bash(npm run:*)",
      "Bash(npx vitest:*)",
      "Bash(npx playwright:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./dist/**/*)",
      "Read(./node_modules/**/*)",
      "Edit(./.claude/settings.json)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/../.claude/hooks/fe-format.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
