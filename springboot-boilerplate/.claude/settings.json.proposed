{
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:javadoc.io)",
      "WebFetch(domain:docs.pmd-code.org)",
      "WebFetch(domain:docs.spring.io)",
      "WebFetch(domain:spring.io)",
      "WebFetch(domain:mybatis.org)",
      "WebFetch(domain:querydsl.com)",
      "WebFetch(domain:code.claude.com)",
      "Bash(./gradlew:*)"
    ],
    "deny": [
      "Read(./src/main/resources/config/datasource/datasource-prd.yml)",
      "Read(./src/main/resources/config/environment/environment-prd.yml)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Read(./**/*.jks)",
      "Read(./**/*.keystore)",
      "Read(./build/**/*)",
      "Edit(./.claude/settings.json)",
      "Edit(./gradle/wrapper/gradle-wrapper.jar)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/../.claude/hooks/be-commit-gate.sh",
            "timeout": 300
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/../.claude/hooks/be-java-notice.sh"
          }
        ]
      }
    ]
  }
}
